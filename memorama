    <!-- Firebase Script Integration -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, collection, addDoc, getDocs } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Firebase Configuration & Global Variables setup
        const firebaseConfig = typeof __firebase_config !== 'undefined' ? JSON.parse(__firebase_config) : {
            apiKey: "demo-api-key",
            authDomain: "demo-app.firebaseapp.com",
            projectId: "demo-app",
            storageBucket: "demo-app.appspot.com",
            messagingSenderId: "123456789",
            appId: "1:123456789:web:abcdef"
        };

        const appId = typeof __app_id !== 'undefined' ? __app_id : 'antidepresivos-memorama';

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        let currentUser = null;

        // Authenticate User
        async function authenticate() {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.warn("Error durante la autenticación de Firebase:", err);
            }
        }

        onAuthStateChanged(auth, (user) => {
            if (user) {
                currentUser = user;
                loadLeaderboard();
            }
        });

        // Initialize Auth
        authenticate();

        // Save Score to Firestore (Rule 1 & Rule 2 compliant path)
        window.saveGameScore = async function(playerData) {
            if (!currentUser) return false;

            try {
                const scoresCol = collection(db, 'artifacts', appId, 'public', 'data', 'scores');
                await addDoc(scoresCol, {
                    playerName: playerData.name || 'Anónimo',
                    email: playerData.email || '',
                    moves: playerData.moves,
                    timeSeconds: playerData.timeSeconds,
                    timeFormatted: playerData.timeFormatted,
                    timestamp: new Date().toISOString(),
                    userId: currentUser.uid
                });
                await loadLeaderboard();
                return true;
            } catch (error) {
                console.error("Error guardando puntaje en Firestore:", error);
                return false;
            }
        };

        // Fetch Leaderboard Records (In-memory sorting per Rule 2)
        window.loadLeaderboard = async function() {
            const leaderboardBody = document.getElementById('leaderboard-body');
            if (!currentUser) {
                leaderboardBody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-slate-500">Conectando con el servidor...</td></tr>`;
                return;
            }

            try {
                const scoresCol = collection(db, 'artifacts', appId, 'public', 'data', 'scores');
                const snapshot = await getDocs(scoresCol);
                let scores = [];

                snapshot.forEach(doc => {
                    scores.push({ id: doc.id, ...doc.data() });
                });

                // Rule 2: Sort in JavaScript Memory (Efficiency: lowest moves, then lowest time)
                scores.sort((a, b) => {
                    if (a.moves !== b.moves) {
                        return a.moves - b.moves;
                    }
                    return a.timeSeconds - b.timeSeconds;
                });

                if (scores.length === 0) {
                    leaderboardBody.innerHTML = `<tr><td colspan="5" class="text-center py-8 text-slate-500">No hay puntuaciones registradas aún. ¡Sé el primero!</td></tr>`;
                    return;
                }

                leaderboardBody.innerHTML = scores.map((item, index) => {
                    let rankBadge = `${index + 1}`;
                    if (index === 0) rankBadge = '🥇';
                    else if (index === 1) rankBadge = '🥈';
                    else if (index === 2) rankBadge = '🥉';

                    const dateStr = item.timestamp ? new Date(item.timestamp).toLocaleDateString('es-ES', { day: '2-digit', month: '2-digit', year: '2-digit' }) : '-';

                    return `
                        <tr class="${index % 2 === 0 ? 'bg-slate-800/30' : 'bg-transparent'} hover:bg-slate-800/60 transition">
                            <td class="p-3 font-bold text-center">${rankBadge}</td>
                            <td class="p-3 font-semibold text-slate-200">${escapeHtml(item.playerName)}</td>
                            <td class="p-3 text-center text-cyan-300 font-medium">${item.moves}</td>
                            <td class="p-3 text-center text-amber-300 font-medium">${item.timeFormatted}</td>
                            <td class="p-3 text-right text-slate-500 text-xs">${dateStr}</td>
                        </tr>
                    `;
                }).join('');

            } catch (err) {
                console.error("Error al cargar la tabla de clasificación:", err);
                leaderboardBody.innerHTML = `<tr><td colspan="5" class="text-center py-6 text-rose-400">Error al cargar datos.</td></tr>`;
            }
        };

        function escapeHtml(str) {
            return (str || '').replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }
    </script>

    <!-- Game Engine Logic -->
    <script>
        // Clinical matching pairs from Antidepresivos presentation
        const cardData = [
            { id: 1, text: 'Amitriptilina' },
            { id: 1, text: 'Tricíclico / Sedante intenso' },
            { id: 2, text: 'Fluoxetina' },
            { id: 2, text: 'ISRS / Estimulante ligero' },
            { id: 3, text: 'Mirtazapina' },
            { id: 3, text: 'NaSSA / Antagonista H1 y α2' },
            { id: 4, text: 'Litio' },
            { id: 4, text: 'Estabilizador / Metal alcalino' },
            { id: 5, text: 'Tranilcipromina' },
            { id: 5, text: 'IMAO no selectivo' },
            { id: 6, text: 'Trazodona' },
            { id: 6, text: 'Modulador 5HT / Priapismo' },
            { id: 7, text: 'Carbamazepina' },
            { id: 7, text: 'Antiepiléptico / Canales Na⁺' },
            { id: 8, text: 'Venlafaxina' },
            { id: 8, text: 'IDRS / IRSN Dual' }
        ];

        let cards = [];
        let flippedCards = [];
        let matchedPairs = 0;
        let moves = 0;
        let timer = 0;
        let timerInterval = null;
        let isLocked = false;

        let playerProfile = {
            name: '',
            email: ''
        };

        // DOM Element references
        const grid = document.getElementById('grid');
        const movesDisplay = document.getElementById('moves');
        const matchesDisplay = document.getElementById('matches');
        const timerDisplay = document.getElementById('timer');

        const modalRegister = document.getElementById('modal-register');
        const modalVictory = document.getElementById('modal-victory');
        const modalLeaderboard = document.getElementById('modal-leaderboard');

        const finalMoves = document.getElementById('final-moves');
        const finalTime = document.getElementById('final-time');
        const saveStatus = document.getElementById('save-status');
        const userDisplayName = document.getElementById('user-display-name');
        const statPlayer = document.getElementById('stat-player');

        function startGame() {
            grid.innerHTML = '';
            flippedCards = [];
            matchedPairs = 0;
            moves = 0;
            timer = 0;
            isLocked = false;

            movesDisplay.textContent = moves;
            matchesDisplay.textContent = `0 / ${cardData.length / 2}`;
            clearInterval(timerInterval);
            timerInterval = null;
            timerDisplay.textContent = "00:00";

            // Prepare and shuffle cards
            cards = [...cardData]
                .sort(() => Math.random() - 0.5)
                .map((card, index) => ({ ...card, uniqueId: index }));

            cards.forEach(card => {
                const cardElement = document.createElement('div');
                cardElement.classList.add('perspective-1000', 'h-28', 'sm:h-32', 'cursor-pointer');
                cardElement.dataset.id = card.id;
                cardElement.dataset.uniqueId = card.uniqueId;

                cardElement.innerHTML = `
                    <div class="relative w-full h-full duration-500 transform-style-3d card-inner rounded-2xl shadow-lg border border-slate-700/50">
                        <!-- Front Face (Hidden state) -->
                        <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-slate-900 to-indigo-950 rounded-2xl flex flex-col items-center justify-center backface-hidden border border-slate-700/60 shadow-inner group hover:border-teal-400/50 transition">
                            <span class="text-2xl md:text-3xl">💊</span>
                            <span class="text-[10px] text-slate-500 font-semibold tracking-widest mt-1">FARMA</span>
                        </div>
                        <!-- Back Face (Revealed State) -->
                        <div class="absolute inset-0 w-full h-full bg-gradient-to-br from-teal-900/90 to-cyan-950/90 border border-teal-400/50 rounded-2xl flex items-center justify-center backface-hidden rotate-y-180 p-2.5 text-center text-xs md:text-sm font-semibold text-slate-100 shadow-xl">
                            ${card.text}
                        </div>
                    </div>
                `;

                cardElement.addEventListener('click', () => flipCard(cardElement, card));
                grid.appendChild(cardElement);
            });
        }

        function startTimer() {
            if (timerInterval) return;
            timerInterval = setInterval(() => {
                timer++;
                let mins = Math.floor(timer / 60).toString().padStart(2, '0');
                let secs = (timer % 60).toString().padStart(2, '0');
                timerDisplay.textContent = `${mins}:${secs}`;
            }, 1000);
        }

        function flipCard(element, card) {
            if (isLocked) return;
            if (element.classList.contains('flipped')) return;
            if (flippedCards.length === 1 && flippedCards[0].uniqueId === card.uniqueId) return;

            startTimer();
            element.querySelector('.card-inner').classList.add('rotate-y-180');
            element.classList.add('flipped');
            flippedCards.push({ element, ...card });

            if (flippedCards.length === 2) {
                moves++;
                movesDisplay.textContent = moves;
                checkMatch();
            }
        }

        function checkMatch() {
            const [card1, card2] = flippedCards;

            if (card1.id === card2.id) {
                matchedPairs++;
                matchesDisplay.textContent = `${matchedPairs} / ${cardData.length / 2}`;
                
                // Visual effect for match
                card1.element.classList.add('opacity-90');
                card2.element.classList.add('opacity-90');
                flippedCards = [];

                if (matchedPairs === cardData.length / 2) {
                    clearInterval(timerInterval);
                    setTimeout(handleVictory, 500);
                }
            } else {
                isLocked = true;
                setTimeout(() => {
                    card1.element.querySelector('.card-inner').classList.remove('rotate-y-180');
                    card1.element.classList.remove('flipped');
                    card2.element.querySelector('.card-inner').classList.remove('rotate-y-180');
                    card2.element.classList.remove('flipped');
                    flippedCards = [];
                    isLocked = false;
                }, 1000);
            }
        }

        async function handleVictory() {
            finalMoves.textContent = moves;
            finalTime.textContent = timerDisplay.textContent;
            saveStatus.textContent = "Guardando resultado en el ranking...";

            modalVictory.classList.remove('hidden');
            modalVictory.classList.add('flex');

            // Save to Firebase
            if (window.saveGameScore) {
                const saved = await window.saveGameScore({
                    name: playerProfile.name || 'Jugador Anónimo',
                    email: playerProfile.email,
                    moves: moves,
                    timeSeconds: timer,
                    timeFormatted: timerDisplay.textContent
                });

                if (saved) {
                    saveStatus.textContent = "✓ ¡Puntuación guardada con éxito!";
                } else {
                    saveStatus.textContent = "Puntuación no guardada (Modo fuera de línea).";
                }
            }
        }

        function handleRegisterSubmit(event) {
            event.preventDefault();
            const nameInput = document.getElementById('input-name').value.trim();
            const emailInput = document.getElementById('input-email').value.trim();

            if (nameInput) {
                playerProfile.name = nameInput;
                playerProfile.email = emailInput;

                userDisplayName.textContent = nameInput;
                statPlayer.textContent = nameInput;
                closeRegisterModal();
            }
        }

        function openRegisterModal(isManual = false) {
            if (playerProfile.name) {
                document.getElementById('input-name').value = playerProfile.name;
                document.getElementById('input-email').value = playerProfile.email || '';
            }
            modalRegister.classList.remove('hidden');
            modalRegister.classList.add('flex');
        }

        function closeRegisterModal() {
            modalRegister.classList.add('hidden');
            modalRegister.classList.remove('flex');
        }

        function openLeaderboardModal() {
            if (window.loadLeaderboard) window.loadLeaderboard();
            modalLeaderboard.classList.remove('hidden');
            modalLeaderboard.classList.add('flex');
        }

        function closeLeaderboardModal() {
            modalLeaderboard.classList.add('hidden');
            modalLeaderboard.classList.remove('flex');
        }

        function resetGame() {
            modalVictory.classList.add('hidden');
            modalVictory.classList.remove('flex');
            startGame();
        }

        // Initialize on page load
        window.onload = function() {
            startGame();
        };
    </script>
</body>
